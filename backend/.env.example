# ==============================================================================
# ScamShield AI — Environment Configuration
# ==============================================================================

# Google OAuth 2.0 Credentials (from Google Cloud Console: console.cloud.google.com)
# Create an OAuth 2.0 Web Application client:
# Authorized JavaScript Origins: http://127.0.0.1:8000, http://localhost:8000
# Authorized Redirect URIs:     http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Secret key for server-side session cookies (any random string)
SECRET_KEY=scamshield_super_secure_quantum_key_2026

# Optional: Gemini API Key for enhanced AI analysis
GEMINI_API_KEY=your_gemini_api_key_here
